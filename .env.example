APP_NAME=OrderFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

SHIPPING_DOMESTIC_COUNTRY_CODE=US
SHIPPING_PROVIDER_DRIVER=fake
SHIPPING_PROVIDER_BASE_URL=https://shipping.example.test
SHIPPING_PROVIDER_API_TOKEN=
SHIPPING_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
SHIPPING_PROVIDER_TIMEOUT_SECONDS=10
SHIPPING_BATCH_SIZE=100
SHIPPING_CLAIM_TIMEOUT_SECONDS=60
SHIPPING_MAXIMUM_ATTEMPTS=5
SHIPPING_INITIAL_RETRY_DELAY_SECONDS=30
SHIPPING_MAXIMUM_RETRY_DELAY_SECONDS=3600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=orderflow-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# JWT_PRIVATE_KEY_PATH=/absolute/path/to/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=/absolute/path/to/jwt-public.pem
# JWT_PRIVATE_KEY_PASSPHRASE=

PAYMENT_FAKE_DECLINE=false
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
OUTBOX_INITIAL_RETRY_DELAY_SECONDS=5
OUTBOX_MAXIMUM_RETRY_DELAY_SECONDS=300
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=orderflow
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=orderflow.events
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=3
RABBITMQ_READ_WRITE_TIMEOUT_SECONDS=6
RABBITMQ_HEARTBEAT_SECONDS=3
RABBITMQ_CONFIRM_TIMEOUT_SECONDS=5
RABBITMQ_ORDER_QUEUE=orderflow.order.payment-status
RABBITMQ_NOTIFICATION_QUEUE=orderflow.notification.user-registered
RABBITMQ_SHIPPING_QUEUE=orderflow.shipping.payment-captured
RABBITMQ_DEAD_LETTER_EXCHANGE=orderflow.dead
RABBITMQ_CONSUMER_PREFETCH_COUNT=10

NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_CLAIM_TIMEOUT_SECONDS=60
NOTIFICATION_MAXIMUM_ATTEMPTS=5
NOTIFICATION_INITIAL_RETRY_DELAY_SECONDS=30
NOTIFICATION_MAXIMUM_RETRY_DELAY_SECONDS=3600

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
