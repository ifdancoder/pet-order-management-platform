        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="RABBITMQ_ORDER_QUEUE" value="orderflow.test.order.payment-status"/>
        <server name="RABBITMQ_NOTIFICATION_QUEUE" value="orderflow.test.notification.user-registered"/>
        <server name="RABBITMQ_SHIPPING_QUEUE" value="orderflow.test.shipping.payment-captured"/>
        <server name="RABBITMQ_PAYMENT_RETURN_QUEUE" value="orderflow.test.payment.return-received"/>
        <server name="RABBITMQ_RETURN_PAYMENT_QUEUE" value="orderflow.test.return.payment-refunded"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
