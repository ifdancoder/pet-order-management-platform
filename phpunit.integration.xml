        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="orderflow_test" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PASSWORD" value="orderflow"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_USERNAME" value="orderflow"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="RABBITMQ_ORDER_QUEUE" value="orderflow.test.order.payment-status" force="true"/>
        <env name="RABBITMQ_NOTIFICATION_QUEUE" value="orderflow.test.notification.user-registered" force="true"/>
        <env name="RABBITMQ_SHIPPING_QUEUE" value="orderflow.test.shipping.payment-captured" force="true"/>
        <env name="RABBITMQ_PAYMENT_RETURN_QUEUE" value="orderflow.test.payment.return-received" force="true"/>
        <env name="RABBITMQ_RETURN_PAYMENT_QUEUE" value="orderflow.test.return.payment-refunded" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="orderflow_test"/>
        <server name="DB_PASSWORD" value="orderflow"/>
        <server name="DB_PORT" value="5432"/>
        <server name="DB_URL" value=""/>
